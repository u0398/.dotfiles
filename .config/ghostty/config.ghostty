# config.ghostty

background = 1e1e2e
foreground = cdd6f4
cursor-color = f5e0dc
cursor-text = 11111b
selection-background = 353749
selection-foreground = cdd6f4
split-divider-color = 313244

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#bac2de

#font-family = "MesloLGS Nerd Font"
font-family = "Hack Nerd Font"
font-size = 12

window-padding-x = 10
window-padding-y = 14,0
window-padding-balance = true


background-opacity = 0.90
#cursor-style = block

keybind = shift+space>space=reload_config

keybind = shift+space>n=new_window
keybind = shift+space>c=close_window

keybind = shift+space>h=goto_split:left
keybind = shift+space>j=goto_split:down
keybind = shift+space>k=goto_split:up
keybind = shift+space>l=goto_split:right

keybind = shift+space>s>h=new_split:left
keybind = shift+space>s>j=new_split:down
keybind = shift+space>s>k=new_split:up
keybind = shift+space>s>l=new_split:right

keybind = shift+space>r>h=resize_split:left,60
keybind = shift+space>r>j=resize_split:down,60
keybind = shift+space>r>k=resize_split:up,60
keybind = shift+space>r>l=resize_split:right,60
keybind = shift+space>r>e=equalize_splits


keybind = shift+space>z=toggle_split_zoom

#keybind = global:super+`=toggle_quick_terminal
